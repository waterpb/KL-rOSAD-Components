local VARIANT = {
	off = { fill = "ctrlOff", text = "text", tr = .25, edge = true },
	on = { fill = "accent", text = "onAccent", tr = .18, edge = true },
	ghost = { fill = "text", text = "text", tr = 1 },
}
local function setKind(b, kind)
	local v = VARIANT[kind]
	paint(b, "BackgroundColor3", v.fill)
	paint(b, "TextColor3", v.text)
	b.BackgroundTransparency = v.tr
	b:SetAttribute("tr", v.tr)
	local s = b:FindFirstChildOfClass("UIStroke")
	paint(s, "Color", v.edge and "edge" or v.fill)
	s.Enabled = v.edge == true
	s.Transparency = kind == "on" and .2 or .7
end
local function button(str, x, y, w, h, kind, cb, pt)
	local b = Instance.new("TextButton")
	b.Text = str; b.TextSize = fs(pt or 9); b.Font = FONT; b.AutoButtonColor = false; b.BorderSizePixel = 0
	b.Position = UDim2.fromOffset(x, y); b.Size = UDim2.fromOffset(w, h)
	b.Parent = win
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	local s = Instance.new("UIStroke", b)
	s.Thickness = 1; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	setKind(b, kind)
	b.MouseEnter:Connect(function() b.BackgroundTransparency = math.max((b:GetAttribute("tr") or 0) - .12, 0) end)
	b.MouseLeave:Connect(function() b.BackgroundTransparency = b:GetAttribute("tr") or 0 end)
	b.MouseButton1Click:Connect(function() cb(b) end)
	return b
end

local function slider(x, y, w, min, max, step, key)
	local hit = Instance.new("TextButton")
	hit.Text = ""; hit.AutoButtonColor = false; hit.BackgroundTransparency = 1; hit.BorderSizePixel = 0
	hit.Position = UDim2.fromOffset(x, y); hit.Size = UDim2.fromOffset(w, 20)
	hit.Parent = win
	local track = Instance.new("Frame")
	track.AnchorPoint = Vector2.new(0, .5); track.Position = UDim2.new(0, 0, .5, 0); track.Size = UDim2.fromOffset(w, 4); track.BorderSizePixel = 0
	track.Parent = hit
	Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)
	paint(track, "BackgroundColor3", "edge")
	local fill = Instance.new("Frame")
	fill.Size = UDim2.new(0, 0, 1, 0); fill.BorderSizePixel = 0; fill.BackgroundTransparency = .2
	fill.Parent = track
	paint(fill, "BackgroundColor3", "accent")
	Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)
	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(.5, .5); knob.Size = UDim2.fromOffset(14, 14); knob.BackgroundColor3 = rgb(255, 255, 255); knob.BorderSizePixel = 0
	knob.Parent = hit
	Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
	local ks = Instance.new("UIStroke", knob); ks.Thickness = 1; ks.Color = rgb(0, 0, 0); ks.Transparency = .6
	local function place(v)
		local f = math.clamp((v - min) / (max - min), 0, 1)
		fill.Size = UDim2.new(f, 0, 1, 0)
		knob.Position = UDim2.new(f, 0, .5, 0)
	end
	local function apply_(px)
		local f = math.clamp((px - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		cfg[key] = math.clamp(math.floor((min + (max - min) * f) / step + .5) * step, min, max)
		M.sync(); schedule()
	end
	local drag = false
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = true; apply_(i.Position.X) end
	end)
	conn(UIS.InputChanged, function(i)
		if drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then apply_(i.Position.X) end
	end)
	conn(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end
	end)
	return place
end

