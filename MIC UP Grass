-- ===== terrain =================================================================
local DEPTH = 4 -- studs of grass buried in the plate, so the surface has no gap
local CLEAR = 4 -- a build counts as "above the grass" when its bottom is within this many studs over the grass surface
local MAX_RECTS = 2500
local function setT(prop, v)
	if pcall(function() Terrain[prop] = v end) then return true end
	return sethiddenproperty ~= nil and pcall(sethiddenproperty, Terrain, prop, v)
end
local function getT(prop)
	local ok, v = pcall(function() return Terrain[prop] end)
	if ok then return v end
	if gethiddenproperty then local o, h = pcall(gethiddenproperty, Terrain, prop); if o then return h end end
end
local orig = { decor = getT("Decoration"), len = getT("GrassLength"), color = Terrain:GetMaterialColor(GRASS) }

-- Mic Up's plates: workspace.Baseplate and everything in workspace.map.extra_room.platform (4 parts); streamed-out parts are skipped.
-- all = true ignores the Baseplate / Extra rooms toggles (used to tell a plate from a build)
local function plates(all)
	local t = {}
	local bp = workspace:FindFirstChild("Baseplate")
	if bp and bp:IsA("BasePart") and (all or cfg.base) then t[#t + 1] = bp end
	local map = workspace:FindFirstChild("map")
	local er = (map and map:FindFirstChild("extra_room")) or workspace:FindFirstChild("extra_room", true)
	if er and (all or cfg.rooms) then
		for _, p in ipairs(er:GetDescendants()) do
			if p:IsA("BasePart") and (p.Name == "platform" or p:FindFirstAncestor("platform")) then t[#t + 1] = p end
		end
	end
	return t
end

-- rect = { x1, z1, x2, z2 } in a plate's own space. Cuts b out of every rect: up to 4 non-overlapping pieces each.
local function subtract(rects, b)
	local out = {}
	for _, r in ipairs(rects) do
		if b[3] <= r[1] or b[1] >= r[3] or b[4] <= r[2] or b[2] >= r[4] then
			out[#out + 1] = r
		else
			local x1, x2 = math.max(r[1], b[1]), math.min(r[3], b[3])
			if b[1] > r[1] then out[#out + 1] = { r[1], r[2], b[1], r[4] } end
			if b[3] < r[3] then out[#out + 1] = { b[3], r[2], r[3], r[4] } end
			if b[2] > r[2] then out[#out + 1] = { x1, r[2], x2, b[2] } end
			if b[4] < r[4] then out[#out + 1] = { x1, b[4], x2, r[4] } end
		end
	end
	return out
end

-- the grass of plate p as rectangles in the plate's space, minus everything built on it (and the count of builds cut out); cfg.margin studs of bare plate stay around each one (negative: grass goes in under them).
-- A build = any other part in the slab from the plate surface up to CLEAR studs over the grass that you can see or collide with.
-- shortcut: a rotated build is cut out by its bounding rectangle (a little extra bare plate), when to upgrade: cut the rotated outline
local function grassRects(p, skip)
	local hx, hz = p.Size.X * cfg.size / 200, p.Size.Z * cfg.size / 200
	local rects, builds = { { -hx, -hz, hx, hz } }, 0
	if not cfg.avoid then return rects, 0 end
	local h = math.max(cfg.offset, 0) + CLEAR
	local op = OverlapParams.new()
	op.FilterType = Enum.RaycastFilterType.Exclude
	op.FilterDescendantsInstances = skip
	op.MaxParts = 3000
	local inv = p.CFrame:Inverse()
	local slab = p.CFrame * CFrame.new(0, p.Size.Y / 2 + 0.05 + h / 2, 0)
	for _, b in ipairs(workspace:GetPartBoundsInBox(slab, Vector3.new(hx * 2, h, hz * 2), op)) do
		if b.CanCollide or b.Transparency < 1 then
			local rel, hs = inv * b.CFrame, b.Size / 2
			local x1, z1, x2, z2 = math.huge, math.huge, -math.huge, -math.huge
			for sx = -1, 1, 2 do for sy = -1, 1, 2 do for sz = -1, 1, 2 do
				local q = rel * Vector3.new(hs.X * sx, hs.Y * sy, hs.Z * sz)
				x1, x2, z1, z2 = math.min(x1, q.X), math.max(x2, q.X), math.min(z1, q.Z), math.max(z2, q.Z)
			end end end
			-- a negative margin shrinks the cut-out: the grass reaches in under the build (a build smaller than that is not cut at all)
			local m = cfg.margin
			if x1 - m < x2 + m and z1 - m < z2 + m then rects = subtract(rects, { x1 - m, z1 - m, x2 + m, z2 + m }) end
			builds = builds + 1
			if #rects > MAX_RECTS then break end -- shortcut: past this the remaining builds keep their grass, when to upgrade: merge rects
		end
	end
	return rects, builds
end

local drawn, tinted, bladesOk, info = {}, {}, true, ""
local function clearAll()
	-- shortcut: clears the exact boxes filled before (+1 stud), so any other terrain there would go too, when to upgrade: ReadVoxels first
	for _, r in ipairs(drawn) do Terrain:FillBlock(r.cf, r.size + Vector3.new(2, 2, 2), AIR) end
	drawn = {}
	for p, c in pairs(tinted) do pcall(function() p.Color = c end) end
	tinted = {}
end
local function restoreTerrain()
	pcall(function() Terrain:SetMaterialColor(GRASS, orig.color) end)
	if orig.decor ~= nil then setT("Decoration", orig.decor) end
	if orig.len ~= nil then setT("GrassLength", orig.len) end
end

local function apply()
	if M.dead then return end
	clearAll()
	info = ""
	if not cfg.on then return restoreTerrain() end
	local list = plates(false)
	if #list == 0 then cfg.on = false; M.sync(); return notify("Grass: no Mic Up baseplate found near you (it may be streamed out)") end
	-- never a build: the plates, every character, the terrain
	local skip = { Terrain }
	for _, p in ipairs(plates(true)) do skip[#skip + 1] = p end
	for _, pl in ipairs(Players:GetPlayers()) do if pl.Character then skip[#skip + 1] = pl.Character end end
	local placed, builds = {}, 0
	for _, p in ipairs(list) do
		local rects, n = grassRects(p, skip)
		placed[p], builds = rects, builds + n
		-- the grass top is the plate top + offset; DEPTH studs of it are buried in the plate
		local d = math.min(DEPTH, p.Size.Y - 0.2)
		local height = d + cfg.offset
		if height > 0.1 then
			for _, r in ipairs(rects) do
				local w, dp = r[3] - r[1], r[4] - r[2]
				if w > 0.25 and dp > 0.25 then
					local cf = p.CFrame * CFrame.new((r[1] + r[3]) / 2, p.Size.Y / 2 + (cfg.offset - d) / 2, (r[2] + r[4]) / 2)
					local sz = Vector3.new(w, height, dp)
					Terrain:FillBlock(cf, sz, GRASS)
					drawn[#drawn + 1] = { cf = cf, size = sz }
				end
			end
		end
	end
	for _, p in ipairs(list) do tinted[p] = p.Color; p.Color = cfg.color end -- the plate takes the grass colour
	Terrain:SetMaterialColor(GRASS, cfg.color)
	bladesOk = setT("Decoration", cfg.blades) and true or false
	if cfg.blades then setT("GrassLength", cfg.blade) end
	if builds > 0 then info = builds .. " build" .. (builds == 1 and "" or "s") .. " skipped: no grass under them" end
	-- a raised floor must not swallow you: lift whoever stands on grass (not inside a build)
	pcall(function()
		local hrp = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
		if not hrp or cfg.offset <= 0.3 then return end
		for p, rects in pairs(placed) do
			local l = p.CFrame:PointToObjectSpace(hrp.Position)
			if l.Y > p.Size.Y / 2 - 1 and l.Y < p.Size.Y / 2 + cfg.offset + 2 then
				for _, r in ipairs(rects) do
					if l.X > r[1] and l.X < r[3] and l.Z > r[2] and l.Z < r[4] then
						hrp.CFrame = hrp.CFrame + Vector3.new(0, cfg.offset + 1, 0)
						return
					end
				end
			end
		end
	end)
	M.sync()
end

local gen = 0
local function schedule() -- sliders fire many times a second: rebuild once they settle
	gen = gen + 1
	local g = gen
	task.delay(.3, function() if g == gen then apply() end end)
end

-- ===== theme (rOSAD's palette, inherited live through its "look" bus) ========
local PAL = {
	Dark = { panel = rgb(8, 8, 10), edge = rgb(72, 70, 80), ctrlOff = rgb(30, 30, 35), btnFill = rgb(40, 40, 46), text = rgb(255, 255, 255),
		sub = rgb(158, 156, 168), hint = rgb(122, 122, 134), danger = rgb(255, 99, 88) },
	Light = { panel = rgb(242, 242, 242), edge = rgb(158, 155, 155), ctrlOff = rgb(250, 250, 250), btnFill = rgb(214, 213, 213), text = rgb(13, 13, 13),
		sub = rgb(84, 81, 81), hint = rgb(107, 103, 103), danger = rgb(206, 38, 30) },
}
local themeName = (K and K.cfg and K.cfg.theme == "Light") and "Light" or "Dark"
local ACCENT = (K and K.S and K.S.accent) or rgb(255, 255, 0)
local ACCENT_TEXT, ACCENT_LABEL = rgb(16, 16, 18), rgb(255, 255, 0)
local U = { tog = {}, sl = {} }
local function accented()
	local l = 0.2126 * ACCENT.R + 0.7152 * ACCENT.G + 0.0722 * ACCENT.B
	ACCENT_TEXT = l > 0.45 and rgb(16, 16, 18) or rgb(255, 255, 255)
	ACCENT_LABEL = themeName == "Dark" and ACCENT or ACCENT:Lerp(rgb(0, 0, 0), .45)
end
accented()
local function col(key)
	if key == "accent" then return ACCENT end
	if key == "accentText" then return ACCENT_LABEL end
	if key == "onAccent" then return ACCENT_TEXT end
	return (PAL[themeName] or PAL.Dark)[key] or rgb(255, 255, 255)
end
local themed = setmetatable({}, { __mode = "k" })
local function paint(o, prop, key)
	local t = themed[o]
	if not t then t = {}; themed[o] = t end
	t[prop] = key
	o[prop] = col(key)
end
local function applyTheme()
	for o, t in pairs(themed) do
		if o.Parent then for prop, key in pairs(t) do pcall(function() o[prop] = col(key) end) end end
	end
	if U.title then U.title.Text = "<font color=\"" .. hex(ACCENT_LABEL) .. "\">&gt;</font>GRASS" end
end

