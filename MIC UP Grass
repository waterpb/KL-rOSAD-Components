function M.sync()
	for _, t in ipairs(U.tog) do
		t.b.Text = t.text .. (cfg[t.key] and ": on" or ": off")
		setKind(t.b, cfg[t.key] and "on" or "off")
	end
	for _, s in ipairs(U.sl) do s.place(cfg[s.key]); s.val.Text = s.fmt(cfg[s.key]) end
	U.hex.Text = hex(cfg.color)
	U.status.Text = (cfg.on and cfg.blades and not bladesOk) and "this executor can't set Terrain.Decoration: no blades"
		or (cfg.on and info ~= "" and info) or "client-side: only you see it"
end

-- ===== commands (rOSAD's ;grass forwards here) ===============================
local NUM = { size = { 10, 100 }, offset = { -3, 2 }, margin = { -3, 2 }, blade = { .2, 3 } }
function M.cmd(a)
	if M.dead then return end
	local w, v = tostring(a or ""):lower():match("^%s*(%S*)%s*(.-)%s*$")
	if w == "lift" then w = "offset" end -- the old name
	if w == "" or w == "toggle" then cfg.on = not cfg.on
	elseif w == "on" then cfg.on = true
	elseif w == "off" then cfg.on = false
	elseif w == "avoid" then cfg.avoid = v ~= "off"
	elseif w == "open" then return M.open()
	elseif w == "close" then return M.close()
	elseif NUM[w] then
		local n = tonumber(v)
		if not n then return notify("Usage: grass " .. w .. " <number>") end
		cfg[w] = math.clamp(n, NUM[w][1], NUM[w][2])
	elseif w == "color" or w == "colour" then
		local c = parseHex(v)
		if not c then return notify("Usage: grass color #RRGGBB") end
		cfg.color = c
	else return notify("grass: on, off, size N, offset N, margin N, blade N, color #hex, avoid, open, close") end
	M.sync(); schedule()
end

function M.open() if not M.dead then M.visible = true; win.Visible = true; M.sync() end end
function M.close() M.visible = false; win.Visible = false end

local unsubLook, unsubUnload
if K and K.ctx and K.ctx.bus then
	unsubLook = K.ctx.bus.on("look", function(s)
		if type(s) ~= "table" then return end
		themeName = s.theme == "Light" and "Light" or "Dark"
		if typeof(s.accent) == "Color3" then ACCENT = s.accent end
		accented()
		win.BackgroundTransparency = 1 - (tonumber(s.opacity) or .88)
		winScale.Scale = tonumber(s.scale) or winScale.Scale
		applyTheme()
	end, true)
	unsubUnload = K.ctx.bus.on("unload", function() M.Unload() end)
end

function M.Unload()
	if M.dead then return end
	M.dead = true
	cfg.on = false
	pcall(clearAll)
	pcall(restoreTerrain)
	for _, c in ipairs(cons) do pcall(function() c:Disconnect() end) end
	if unsubLook then pcall(unsubLook) end
	if unsubUnload then pcall(unsubUnload) end
	pcall(function() gui:Destroy() end)
	if env.KLGrass == M then env.KLGrass = nil end
end

-- ===== self-check of the pure logic ==========================================
local okT, errT = pcall(function()
	assert(hex(parseHex("#73E775")) == "#73E775" and not parseHex("red") and not parseHex("#12"), "hex")
	local r = subtract({ { -10, -10, 10, 10 } }, { -2, -2, 2, 2 })
	local area = 0
	for _, q in ipairs(r) do area = area + (q[3] - q[1]) * (q[4] - q[2]) end
	assert(math.abs(area - 384) < 1e-6, "a 4x4 build cut out of 20x20 leaves 384")
	assert(#subtract({ { 0, 0, 4, 4 } }, { 10, 10, 12, 12 }) == 1, "a far build changes nothing")
	assert(#subtract({ { 0, 0, 4, 4 } }, { -1, -1, 5, 5 }) == 0, "a build covering the plate leaves nothing")
end)
if not okT then warn("[KLGrass] self-test failed: " .. tostring(errT)) end

applyTheme()
