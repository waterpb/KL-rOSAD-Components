    local knob = new("Frame", {Size = UDim2.fromOffset(18, 18), BackgroundColor3 = KNOB_OFF, BorderSizePixel = 0}, sw)
    local function set(v)
        S[key] = v
        local t = TweenInfo.new(0.12)
        TS:Create(sw, t, {BackgroundColor3 = v and ACCENT or OFF}):Play()
        TS:Create(knob, t, {Position = UDim2.fromOffset(v and 18 or 0, 0),
            BackgroundColor3 = v and KNOB_ON or KNOB_OFF}):Play()
        save()
    end
    sw.MouseButton1Click:Connect(function() set(not S[key]) end)
    setters[key] = set
    set(S[key])
end

local function addDropdown(items, onPick)
    local r = row(24)
    local head = new("TextButton", {Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = BTN, Text = "", AutoButtonColor = false,
        BorderSizePixel = 0}, r)
    outline(head, TEXT)
    local cur = label(head, "", {Position = UDim2.fromOffset(8, 0), Size = UDim2.new(1, -28, 1, 0)})
    label(head, "v", {Position = UDim2.new(1, -22, 0, 0), Size = UDim2.fromOffset(16, 24), TextColor3 = MUTED,
        TextXAlignment = Enum.TextXAlignment.Center})
    local list = new("Frame", {Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, #items * 22),
        BackgroundColor3 = BTN, BorderSizePixel = 0, Visible = false}, r)
    outline(list, TEXT)
    local btns = {}
    local function pick(name, apply)
        cur.Text = name
        for n, b in pairs(btns) do b.TextColor3 = n == name and ACCENT or TEXT end
        onPick(name, apply)
    end
    local function close() list.Visible = false r.Size = UDim2.new(1, 0, 0, 24) end
    for i, name in ipairs(items) do
        local b = new("TextButton", {Position = UDim2.fromOffset(0, (i - 1) * 22), Size = UDim2.new(1, 0, 0, 22),
            BackgroundTransparency = 1, Text = "  " .. name, TextColor3 = TEXT, Font = FONT, TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0}, list)
        btns[name] = b
        b.MouseButton1Click:Connect(function() pick(name, true) close() end)
    end
    head.MouseButton1Click:Connect(function()
        list.Visible = not list.Visible
        r.Size = UDim2.new(1, 0, 0, list.Visible and 28 + #items * 22 or 24)
    end)
    pick(S.mode, false)
end

