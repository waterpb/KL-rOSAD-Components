local shown = 0
on(RS.RenderStepped, function(dt)
    osd.Visible = S.osd
    if not S.osd then return end
    local t = 1 - S.osdalpha -- opacity applied per element (works everywhere, no CanvasGroup)
    osdNum.TextTransparency, osdNum.TextStrokeTransparency = t, t
    barBg.BackgroundTransparency, barStroke.Transparency, barFill.BackgroundTransparency = 1 - S.osdalpha * 0.5, t, t
    local v = (root and root.Parent) and root.AssemblyLinearVelocity or Vector3.zero
    shown += (Vector3.new(v.X, 0, v.Z).Magnitude - shown) * (1 - math.exp(-20 * dt)) -- horizontal studs/s, smoothed
    osdNum.Text = string.format("%d u/s", math.floor(shown + 0.5))
    barFill.Size = UDim2.fromScale(math.clamp(shown / (BASE_SPEED * 3), 0, 1), 1) -- full bar = 3x run speed
end)

