-- HL XP: GoldSrc (HL / CS 1.3) movement + surf. Executor / LocalScript. RightShift hides the panel.
-- Re-running replaces the previous run (old one is shut down first).
--
-- Roblox's own physics does all collision: a friction-free cylinder hull is welded to the root part and the
-- character's real parts stop colliding. This script only owns the velocity each frame: GoldSrc ground
-- friction/accelerate, air accelerate (strafe + surf), jump, and step-up for stairs.
-- Animations: your own Roblox animation assets (see ANIMS below), played client-side on your Animator.

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RS = game:GetService("RunService")
local TS = game:GetService("TweenService")
local player = Players.LocalPlayer

local BASE_SPEED = 16         -- studs/s that equal GoldSrc's 250 u/s run speed (use your game's WalkSpeed)
local UNIT = BASE_SPEED / 250 -- studs per GoldSrc unit
local FEET, HEAD, WIDTH = 3, 2, 2 -- hull: feet/head distance from root, diameter

-- your animation assets. ref = horizontal studs/s at which the clip plays at 1x (clip speed scales with your
-- real speed). Leave ref out for clips that should always play at normal speed.
local ANIMS = {
    idle = {id = 133701744573489},
    walk = {id = 70900360481405, ref = 130 * UNIT},
    run  = {id = 100654766820262, ref = BASE_SPEED},
    jump = {id = 99648731475556},
}

-- GoldSrc units. surfangle: slopes steeper than this are ramps (no friction, air accelerate), not ground
local GAME = "Game default" -- physics mode that leaves the game's own movement alone
local S = {enabled = true, speed = 1, friction = 4, edgefriction = 2, stopspeed = 100, accel = 10, airaccel = 10, aircap = 30,
    stepsize = 18, jump = 268, gravity = 800, maxvel = 2000, surfangle = 45.5, autohop = false, facecam = false, wheeljump = false, antifall = false,
    mode = GAME, osd = false, osdalpha = 0.9, hlanim = true, voidsafe = true}
local DEFAULTS = table.clone(S)
-- per-mode physics presets; "Reset mode" restores the active mode's preset (nothing else). Add Source / CS:GO here.
local PRESETS = {
    GoldSrc = {speed = 1, friction = 4, edgefriction = 2, stopspeed = 100, accel = 10, airaccel = 10, aircap = 30, stepsize = 18,
        jump = 268, gravity = 800, maxvel = 2000, surfangle = 45.5, autohop = false},
    -- CS 1.3/1.6 on GoldSrc: sv_accelerate 5, sv_stopspeed 75 (GoldSrc above = Half-Life's own 10 / 100)
    ["CS 1.6"] = {speed = 1, friction = 4, edgefriction = 2, stopspeed = 75, accel = 5, airaccel = 10, aircap = 30,
        stepsize = 18, jump = 268, gravity = 800, maxvel = 2000, surfangle = 45.5, autohop = false},
    -- CS:S / HL2 engine values (sv_accelerate 5, sv_stopspeed 75, jump = sqrt(2*800*57), sv_maxvelocity 3500)
    Source = {speed = 1, friction = 4, edgefriction = 2, stopspeed = 75, accel = 5, airaccel = 10, aircap = 30,
        stepsize = 18, jump = 302, gravity = 800, maxvel = 3500, surfangle = 45.6, autohop = false},
    -- CS:GO matchmaking-style values (sv_accelerate 5.5, sv_airaccelerate 12, sv_friction 5.2, sv_stopspeed 80)
    ["CS:GO"] = {speed = 1, friction = 5.2, edgefriction = 2, stopspeed = 80, accel = 5.5, airaccel = 12, aircap = 30,
        stepsize = 18, jump = 302, gravity = 800, maxvel = 3500, surfangle = 45.6, autohop = false},
}

-- ===== persistence (executor file API) =====
local HttpService = game:GetService("HttpService")
local FILE, savedPos = "HLXP_settings.json", nil
local modeVals = {} -- each physics mode remembers its own tweaked values
pcall(function()
    if isfile and readfile and isfile(FILE) then
        local d = HttpService:JSONDecode(readfile(FILE))
        for k, v in pairs(d.S or {}) do
            if k ~= "enabled" and type(v) == type(DEFAULTS[k]) then S[k] = v end
        end
        savedPos = d.pos
        for m, t in pairs(d.modes or {}) do
            if PRESETS[m] and type(t) == "table" then modeVals[m] = t end
        end
    end
end)

-- ===== single instance =====
local ENV = (getgenv and getgenv()) or _G
local KEY = "__HLXP_SHUTDOWN"
if type(ENV[KEY]) == "function" then pcall(ENV[KEY]) end
local playerGui = player:WaitForChild("PlayerGui")
local host = playerGui
do
    local ok, h = pcall(function() return gethui and gethui() end)
    if ok and h then
        host = h
    elseif pcall(function() return game:GetService("CoreGui"):GetChildren() end) then
        host = game:GetService("CoreGui")
    end
    for _, c in ipairs({playerGui, host}) do
        for _, nm in ipairs({"HLXP", "HLXPOSD"}) do
            local old = c:FindFirstChild(nm)
            if old then old:Destroy() end
        end
    end
end

-- ===== state =====
local conns, setters = {}, {}
local osdGui
local hum, root, chr, owned, gui, hull, align, att, g0, controls, cmd
local rot = CFrame.identity
local oldJump, wheel, walkY = false, false, 0.7
local lastJump, hsave = 0, nil
local grounded, resetAnim = true, nil
local footSize = Vector3.new(WIDTH - 0.1, 0.1, WIDTH - 0.1)
local saved = {} -- character parts whose CanCollide we turned off
local safePos = nil -- last grounded position (void protection)
local release

local function on(signal, fn)
    local c = signal:Connect(fn)
    conns[#conns + 1] = c
    return c
end

local function shutdown()
    if ENV[KEY] == shutdown then ENV[KEY] = nil end
    for _, c in ipairs(conns) do c:Disconnect() end
    table.clear(conns)
    if owned then release() end
    if gui then gui:Destroy() end
    if osdGui then osdGui:Destroy() end
end
ENV[KEY] = shutdown

-- ===== queries (only used for ground check + step-up; the engine does the actual collision) =====
local params = RaycastParams.new()
params.FilterType = Enum.RaycastFilterType.Exclude
params.RespectCanCollide = true
params.IgnoreWater = true
local castSize, hullOff = Vector3.one, Vector3.zero

local function cast(p, d) return workspace:Blockcast(CFrame.new(p + hullOff), castSize, d, params) end

-- shapecast normals are diagonal on part edges; a ray at the contact point gives the real face normal
local function normalOf(hit)
    local n = hit.Normal
    if n.Magnitude < 0.5 then return nil end
    local r = workspace:Raycast(hit.Position + n * 0.1, -n * 0.3, params)
    return (r and r.Instance == hit.Instance and r.Normal:Dot(n) > 0.3) and r.Normal or n
end

-- ===== GoldSrc pieces =====
local function friction(v, pos, dt) -- PM_Friction + edge friction
    local speed = v.Magnitude
    if speed < 0.1 * UNIT then return Vector3.zero end
    local f = S.friction
    local ahead = pos + v / speed * (16 * UNIT)
    if not workspace:Raycast(Vector3.new(ahead.X, pos.Y - FEET + 0.05, ahead.Z), Vector3.new(0, -34 * UNIT, 0), params) then
        f *= S.edgefriction
    end
    return v * (math.max(speed - math.max(speed, S.stopspeed * UNIT) * f * dt, 0) / speed)
end

-- PM_Accelerate / PM_AirAccelerate (air passes cap = 30 units: that cap is what makes strafing and surfing work)
local function accelerate(v, dir, wishspeed, rate, cap, dt)
    local add = math.min(wishspeed, cap) - v:Dot(dir)
    if add > 0 then v += dir * math.min(rate * dt * wishspeed, add) end
    return v
end

-- walk up stairs: if the hull is blocked by a non-walkable face but is free one step higher with floor to land
-- on, lift the character. Step height = stepsize slider.
local function stepUp(pos, v, dt)
    local hv = Vector3.new(v.X, 0, v.Z)
    local sp = hv.Magnitude
    if sp < 1 then return end
    local d = hv.Unit * (sp * dt + 0.25)
    local blk = cast(pos, d)
    local bn = blk and normalOf(blk)
    if not bn or bn.Y > 0.3 then return end -- only near-vertical risers, never ramps
    local up = Vector3.new(0, S.stepsize * UNIT, 0)
    if cast(pos, up) or cast(pos + up, d) then return end
    local dn = cast(pos + up + d, -up)
    local dnn = dn and normalOf(dn)
    if dnn and dnn.Y >= walkY then
        local rise = up.Y - dn.Distance
        if rise > 0.05 then root.CFrame += Vector3.new(0, rise + 0.03, 0) end
    end
end

-- ===== character binding =====
local function take()
    owned, saved = true, {}
    g0 = workspace.Gravity
    local lv = root.CFrame.LookVector
    local flat = Vector3.new(lv.X, 0, lv.Z)
    rot = CFrame.lookAt(Vector3.zero, flat.Magnitude > 1e-3 and flat or Vector3.zAxis)

    hull = Instance.new("Part") -- vertical cylinder: yaw-invariant, so the cast box matches it
    hull.Name, hull.Shape, hull.Transparency = "HLXPHull", Enum.PartType.Cylinder, 1
    hull.Size = Vector3.new(FEET + HEAD, WIDTH, WIDTH)
    hull.CFrame = root.CFrame * CFrame.new(hullOff) * CFrame.Angles(0, 0, math.pi / 2)
    hull.CustomPhysicalProperties = PhysicalProperties.new(0.5, 0, 0, 100, 100) -- no friction / bounce: we do that
    hull.CollisionGroup = root.CollisionGroup
    hull.Parent = chr
    local w = Instance.new("WeldConstraint")
    w.Part0, w.Part1, w.Parent = root, hull, hull

    att = Instance.new("Attachment")
    att.Parent = root
    align = Instance.new("AlignOrientation") -- keeps the body upright, faces where we say
    align.Mode, align.RigidityEnabled, align.Attachment0, align.CFrame = Enum.OrientationAlignmentMode.OneAttachment, true, att, rot
    align.Parent = root
    hum.PlatformStand = true
    hsave = {hum.JumpPower, hum.JumpHeight}
    hum.JumpPower, hum.JumpHeight = 0, 0 -- the game's own jump must not exist while we're on
    cmd = root.AssemblyLinearVelocity
    local pm = player:FindFirstChild("PlayerScripts") and player.PlayerScripts:FindFirstChild("PlayerModule")
    if pm then -- stop the game's ControlModule from driving the Humanoid (Jump / Move)
        pcall(function() controls = require(pm):GetControls() controls:Disable() end)
    end
end

function release()
    owned = false
    if resetAnim then resetAnim(true) end
    if g0 then workspace.Gravity = g0 end
    if hull then hull:Destroy() end
    if align then align:Destroy() end
    if att then att:Destroy() end
    for p in pairs(saved) do
        if p.Parent then p.CanCollide = true end
    end
    saved, cmd, safePos = {}, nil, nil
    if hsave and hum and hum.Parent then hum.JumpPower, hum.JumpHeight = hsave[1], hsave[2] end
    hsave = nil
    if controls then pcall(function() controls:Enable() end) controls = nil end
    if hum and hum.Parent then
        hum.PlatformStand = false
        hum:ChangeState(Enum.HumanoidStateType.GettingUp)
    end
end

local function bind(char)
    if owned then release() end
    local h = char:WaitForChild("Humanoid")
    local r = char:WaitForChild("HumanoidRootPart")
    chr, hum, root = char, h, r
    FEET = h.RigType == Enum.HumanoidRigType.R6 and 3 or h.HipHeight + r.Size.Y / 2
    castSize = Vector3.new(WIDTH - 0.04, FEET + HEAD - 0.04, WIDTH - 0.04)
    hullOff = Vector3.new(0, (HEAD - FEET) / 2, 0)
    params.FilterDescendantsInstances = {char}
    params.CollisionGroup = r.CollisionGroup
end
on(player.CharacterAdded, bind)
if player.Character then task.spawn(bind, player.Character) end

-- Stepped runs before physics; the Humanoid re-enables collisions, so this has to run every frame
on(RS.Stepped, function()
    if not (owned and chr) then return end
    hum.PlatformStand = true
    hum.JumpPower, hum.JumpHeight = 0, 0 -- games reset these
    local st = hum:GetState()
    if S.antifall then -- Physics state: the game never sees FreeFall/Landed, so state-based fall damage can't trigger
        if st ~= Enum.HumanoidStateType.Physics then hum:ChangeState(Enum.HumanoidStateType.Physics) end
    elseif st == Enum.HumanoidStateType.Physics then
        hum:ChangeState(Enum.HumanoidStateType.PlatformStanding)
    end
    if cmd then root.AssemblyLinearVelocity = cmd end
    for _, d in ipairs(chr:GetDescendants()) do
        if d:IsA("BasePart") and d ~= hull and d.CanCollide then
            saved[d] = true
            d.CanCollide = false
        end
    end
end)

-- ===== input + main loop =====
local function inputDir() -- camera-relative (keyboard fallback: MoveDirection can be 0 while PlatformStanded)
    local c = workspace.CurrentCamera.CFrame
    local f, r = Vector3.new(c.LookVector.X, 0, c.LookVector.Z), Vector3.new(c.RightVector.X, 0, c.RightVector.Z)
    if f.Magnitude < 0.01 or r.Magnitude < 0.01 then return Vector3.zero end
    f, r = f.Unit, r.Unit
    local d = Vector3.zero
    if UIS:IsKeyDown(Enum.KeyCode.W) then d += f end
    if UIS:IsKeyDown(Enum.KeyCode.S) then d -= f end
    if UIS:IsKeyDown(Enum.KeyCode.D) then d += r end
    if UIS:IsKeyDown(Enum.KeyCode.A) then d -= r end
    return d.Magnitude > 0.01 and d.Unit or Vector3.zero
end

on(RS.Heartbeat, function(dt)
    local live = S.enabled and S.mode ~= GAME and hum and root and hum.Parent and root.Parent and hum.Health > 0 and not hum.SeatPart
    if not live then
        if owned then release() end
        return
    end
    if not owned then take() end
    dt = math.min(dt, 0.05)
    workspace.Gravity = S.gravity * UNIT -- the engine applies gravity; we never touch it in the maths below
    walkY = math.cos(math.rad(S.surfangle))

    local pos, vel = root.Position, root.AssemblyLinearVelocity -- vel already has the engine's collision response
    if S.voidsafe and safePos and pos.Y < workspace.FallenPartsDestroyHeight + 80 then
        pos, vel = safePos + Vector3.new(0, 4, 0), Vector3.zero
        root.CFrame = CFrame.new(pos) * (root.CFrame - root.Position)
        root.AssemblyLinearVelocity = vel
    end
    local move = inputDir()
    local wishdir = move.Magnitude > 0.01 and move.Unit or Vector3.zero
    local wishspeed = math.min(move.Magnitude * 1.6, 1) * 250 * UNIT * S.speed
    local jumpBtn = UIS:IsKeyDown(Enum.KeyCode.Space) or wheel
    wheel = false

    local probe = S.antifall and 0.21 or 0.1 -- wide probe softens landings
    if jumpBtn and vel.Y < 0 then probe = math.max(probe, -vel.Y * dt * 1.2) end -- catch the floor before we hit it
    -- thin foot-level box that starts 0.4 above the feet: landing penetration can no longer start it inside the
    -- floor (that returned nothing, so you counted as airborne and slid with no friction)
    local feet = pos - Vector3.new(0, FEET, 0)
    local hit = workspace:Blockcast(CFrame.new(feet + Vector3.new(0, 0.4, 0)), footSize, Vector3.new(0, -(0.4 + probe), 0), params)
    local n = hit and normalOf(hit)
    local gap = hit and hit.Distance - 0.35 or math.huge -- feet-to-floor distance (negative = sunk into it)
    local onGround = n ~= nil and n.Y >= walkY and gap <= probe and vel:Dot(n) < S.jump * 0.5 * UNIT
        and os.clock() - lastJump > 0.12

    local jumping = false
    if jumpBtn then
        jumping = onGround and (not oldJump or S.autohop) -- must release jump between hops unless auto-hop
        oldJump = true
    else
        oldJump = false
    end
    if jumping then
        onGround = false
        -- take off from exactly floor level, so hops start identical to a standing jump (no impact/push-out boost)
        root.CFrame += Vector3.new(0, -math.clamp(gap - 0.01, -0.35, probe), 0)
        lastJump = os.clock()
        vel = Vector3.new(vel.X, S.jump * UNIT, vel.Z)
    end

    if onGround then
        vel += Vector3.new(0, workspace.Gravity * dt, 0) -- undo this frame's gravity so slopes don't creep
        vel -= n * vel:Dot(n)                           -- ride the floor plane at full speed
        vel = friction(vel, pos, dt)
        local wd = wishdir - n * wishdir:Dot(n)
        if wd.Magnitude > 1e-3 then vel = accelerate(vel, wd.Unit, wishspeed, S.accel, math.huge, dt) end
    elseif wishdir ~= Vector3.zero then
        vel = accelerate(vel, wishdir, wishspeed, S.airaccel, S.aircap * UNIT, dt)
    end

    if vel ~= vel then vel = Vector3.zero end
    local m = S.maxvel * UNIT
    vel = Vector3.new(math.clamp(vel.X, -m, m), math.clamp(vel.Y, -m, m), math.clamp(vel.Z, -m, m))
    if onGround and wishspeed > 0 then stepUp(pos, vel, dt) end
    grounded = onGround
    if onGround then safePos = root.Position end
    cmd = vel
    root.AssemblyLinearVelocity = vel

    local face
    if S.facecam then
        local lv = workspace.CurrentCamera.CFrame.LookVector
        face = Vector3.new(lv.X, 0, lv.Z)
    else
        face = Vector3.new(vel.X, 0, vel.Z)
        if face.Magnitude < 2 then face = Vector3.zero end
    end
    if face.Magnitude > 1e-3 then rot = rot:Lerp(CFrame.lookAt(Vector3.zero, face), 1 - math.exp(-16 * dt)) end
    align.CFrame = rot
end)

-- ===== animations (your Roblox assets, played client-side on the local Animator) =====
-- The game's own Animate script is switched off while this is on, and its idle/walk/movement tracks are stopped,
-- so only your four clips play. Animator tracks started by the client replicate to everyone else.
local tracks, mine = {}, {} -- clip name -> AnimationTrack, and the reverse set
local animDisabled, animStatusLbl, lastStatus, animWarned
local ap = {clip = nil, air = 0}
local function status(msg) -- shown under the animation switch
    if msg ~= lastStatus and animStatusLbl then
        lastStatus = msg
        animStatusLbl.Text = msg
    end
end

local function loadTracks()
    local an = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    for name, a in pairs(ANIMS) do
        local anim = Instance.new("Animation")
        anim.AnimationId = "rbxassetid://" .. a.id
        local ok, tr = pcall(function() return an:LoadAnimation(anim) end)
        if ok and tr then
            tr.Priority = Enum.AnimationPriority.Movement
            tr.Looped = name ~= "jump"
            tracks[name], mine[tr] = tr, true
        else
            warn("[HLXP anim] could not load " .. name .. " (" .. a.id .. "): " .. tostring(tr))
        end
    end
end

function resetAnim(unload) -- stop our clips; give the game's Animate script back
    for _, tr in pairs(tracks) do
        pcall(function() tr:Stop(0.1) end)
        if unload then pcall(function() tr:Destroy() end) end
    end
    if unload then tracks, mine = {}, {} end
    ap.clip, ap.air = nil, 0
    if animDisabled then
        local a = chr and chr:FindFirstChild("Animate")
        if a then a.Disabled = false end
        animDisabled = false
    end
end

local LOW = {[Enum.AnimationPriority.Core] = true, [Enum.AnimationPriority.Idle] = true,
    [Enum.AnimationPriority.Movement] = true}

local function animUpdate(dt)
    local live = owned and chr and hum and root and hum.Parent
    if not (S.hlanim and live) then
        if animDisabled or ap.clip then resetAnim() end
        status(live and "anim: off" or "anim: waiting - pick a physics mode and turn Enabled on")
        return
    end

    local a = chr:FindFirstChild("Animate") -- silence the game's own animations
    if a and not a.Disabled then a.Disabled = true animDisabled = true end
    if not next(tracks) then loadTracks() end
    local an = hum:FindFirstChildOfClass("Animator")
    if an then
        for _, tr in ipairs(an:GetPlayingAnimationTracks()) do
            if not mine[tr] and LOW[tr.Priority] then tr:Stop(0) end -- leave tool / action animations alone
        end
    end

    local hs = cmd and Vector3.new(cmd.X, 0, cmd.Z).Magnitude or 0
    ap.air = grounded and 0 or ap.air + dt
    local run = 250 * UNIT
    local want = ap.air > 0.08 and "jump" or hs < 0.05 * run and "idle" or hs < 0.62 * run and "walk" or "run"
    if want ~= ap.clip then
        local old, new = tracks[ap.clip], tracks[want]
        if old then old:Stop(0.12) end
        if new then new:Play(0.12) end
        ap.clip = want
    end

    local tr = tracks[want]
    if tr then
        local ref = ANIMS[want].ref
        if ref then
            tr:AdjustSpeed(math.clamp(hs / ref, 0.4, 3)) -- clip speed follows real speed
        elseif want == "jump" and tr.Length > 0 and tr.TimePosition >= tr.Length - 0.05 then
            tr:AdjustSpeed(0) -- hold the last frame until we land
        end
        status(tr.Length > 0 and string.format("anim: %s playing (%s)", want, hum.RigType.Name)
            or string.format("anim: %s loading / failed (check the asset id + ownership)", want))
    else
        status("anim: " .. want .. " track missing")
    end
end

on(RS.RenderStepped, function(dt)
    local ok, err = pcall(animUpdate, dt)
    if not ok then
        status("anim ERROR: " .. tostring(err))
        if not animWarned then
            animWarned = true
            warn("[HLXP anim] " .. tostring(err))
        end
    end
end)

-- ===== UI (dark see-through panel, square corners, monospace, blue accent) =====
local BG, TEXT, MUTED = Color3.fromRGB(23, 22, 22), Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)
local BTN, ACCENT = Color3.fromRGB(62, 60, 55), Color3.fromRGB(91, 155, 213)
local OFF, KNOB_OFF, KNOB_ON = Color3.fromRGB(17, 17, 17), Color3.fromRGB(207, 207, 207), Color3.fromRGB(222, 235, 246)
local BLACK = Color3.new(0, 0, 0)

-- FONT: built-in fallback, loads instantly. Code = fixed-width, closest built-in to a bitmap font.
-- Alternatives: Enum.Font.Legacy (the old Roblox UI font, not monospace) or Enum.Font.Arcade (pixel, caps only).
-- ProggyClean: drop ProggyClean.ttf into your executor's workspace folder and it is used automatically
-- (local file, so no loading delay). It is a 13px bitmap font, so text sizes below are 13 (26 = 2x) to stay sharp.
local FONT, FONT_FILE, FONTFACE = Enum.Font.Code, "ProggyClean.ttf", nil
pcall(function()
    if isfile and writefile and getcustomasset and isfile(FONT_FILE) then
        writefile("HLXP_font.json", HttpService:JSONEncode({name = "ProggyClean", faces = {
            {name = "Regular", weight = 400, style = "normal", assetId = getcustomasset(FONT_FILE)}}}))
        FONTFACE = Font.new(getcustomasset("HLXP_font.json"))
    end
end)

local function new(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props) do i[k] = v end
    if FONTFACE and (i:IsA("TextLabel") or i:IsA("TextButton")) then i.FontFace = FONTFACE end
    i.Parent = parent
    return i
end
local function outline(i, color)
    new("UIStroke", {Color = color, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, i)
end
local function label(parent, str, props)
    local p = {BackgroundTransparency = 1, Text = str, TextColor3 = TEXT, Font = FONT, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left}
    for k, v in pairs(props or {}) do p[k] = v end
    return new("TextLabel", p, parent)
end
local function isPress(i)
    return i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch
end

gui = new("ScreenGui", {Name = "HLXP", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    DisplayOrder = 2147483647, IgnoreGuiInset = true}, host) -- above Roblox UI and the game's
local W, H, HEADER = 300, 620, 32
local main = new("Frame", {Size = UDim2.fromOffset(W, H), Position = UDim2.new(0, 40, 0.5, -H / 2),
    BackgroundColor3 = BG, BackgroundTransparency = 0.2, BorderSizePixel = 0, ClipsDescendants = true}, gui)
new("UIStroke", {Color = BLACK, Thickness = 1.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, main)

if savedPos then main.Position = UDim2.new(savedPos[1], savedPos[2], savedPos[3], savedPos[4]) end
local ready, pending, applying = false, false, false
local function save() -- remembers the active mode's values; debounced file write, no-op until the UI is built
    if applying then return end
    local pm = PRESETS[S.mode]
    if pm then
        local t = modeVals[S.mode] or {}
        modeVals[S.mode] = t
        for k in pairs(pm) do t[k] = S[k] end
    end
    if not ready or pending or not writefile then return end
    pending = true
    task.delay(0.5, function()
        pending = false
        local p = main.Position
        pcall(writefile, FILE, HttpService:JSONEncode({S = S, modes = modeVals, pos = {p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset}}))
    end)
